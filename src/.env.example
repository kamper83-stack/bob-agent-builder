# Copy this file to src/.env and fill in your credentials.
# src/.env is gitignored — never commit real keys.

# Google Gemini API key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Gemini model alias (default: gemini-flash-latest — always resolves to current stable flash)
# Other aliases: gemini-pro-latest, gemini-flash-lite-latest
# Or use exact names like: models/gemini-3.5-flash-lite
GEMINI_MODEL=gemini-flash-latest

# IBM Cloud API key (from cloud.ibm.com → Manage → Access → API keys)
WATSONX_APIKEY=

# watsonx.ai project ID (from your project's Manage tab)
WATSONX_PROJECT_ID=

# Regional endpoint (default: us-south — change if your project is in another region)
# Options: https://us-south.ml.cloud.ibm.com
#          https://eu-de.ml.cloud.ibm.com
#          https://eu-gb.ml.cloud.ibm.com
#          https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Email (Mailpit — fake SMTP for local dev/QA) ─────────────────────────────
# Start with: docker compose up -d
# Web UI to read captured emails: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=agent@localhost
# MAILPIT_UI_URL is used by the frontend connector label only
MAILPIT_UI_URL=http://localhost:8025

