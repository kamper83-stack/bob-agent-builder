# Backend server URL — used by the Next.js API proxy routes (server-side only)
BACKEND_URL=http://localhost:8000

# Mailpit web UI URL — shown in the Email connector label in the UI
# Start Mailpit: docker compose up -d  →  http://localhost:8025
NEXT_PUBLIC_MAILPIT_URL=http://localhost:8025
NEXT_PUBLIC_SMTP_HOST=localhost:1025
